<?xml version="1.0" encoding="utf-8"?>
<manifest xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:tools="http://schemas.android.com/tools">

    <!-- Rede: envio UDP para o painel (porta 17065) e escuta de respostas (17066) -->
    <uses-permission android:name="android.permission.INTERNET" />
    <uses-permission android:name="android.permission.ACCESS_NETWORK_STATE" />
    <uses-permission android:name="android.permission.ACCESS_WIFI_STATE" />

    <!-- Serviço em primeiro plano: executa os envios agendados com o app fechado -->
    <uses-permission android:name="android.permission.FOREGROUND_SERVICE" />
    <uses-permission android:name="android.permission.FOREGROUND_SERVICE_DATA_SYNC" />
    <uses-permission android:name="android.permission.POST_NOTIFICATIONS" />
    <!-- Recria os alarmes da agenda depois que o celular reinicia -->
    <uses-permission android:name="android.permission.RECEIVE_BOOT_COMPLETED" />

    <!-- USB Host / OTG: configuração do módulo WiFi (ESP-AT) via HID Microchip -->
    <uses-feature android:name="android.hardware.usb.host" android:required="false" />

    <application
        android:name=".PainelApp"
        android:allowBackup="true"
        android:icon="@drawable/ic_launcher"
        android:label="@string/app_name"
        android:supportsRtl="true"
        android:theme="@style/Theme.PainelOfertas"
        tools:targetApi="31">

        <activity
            android:name=".ui.MainActivity"
            android:exported="true"
            android:label="@string/app_name"
            android:theme="@style/Theme.PainelOfertas">
            <intent-filter>
                <action android:name="android.intent.action.MAIN" />
                <category android:name="android.intent.category.LAUNCHER" />
            </intent-filter>

            <!-- Abre o app automaticamente quando o painel (HID Microchip) é conectado por USB -->
            <intent-filter>
                <action android:name="android.hardware.usb.action.USB_DEVICE_ATTACHED" />
            </intent-filter>
            <meta-data
                android:name="android.hardware.usb.action.USB_DEVICE_ATTACHED"
                android:resource="@xml/usb_device_filter" />
        </activity>

        <!-- Agendamento em segundo plano: alarme acorda o receiver, que sobe o serviço -->
        <receiver
            android:name=".schedule.ScheduleReceiver"
            android:exported="false">
            <intent-filter>
                <action android:name="br.com.painelofertas.AGENDA_DISPARO" />
                <action android:name="android.intent.action.BOOT_COMPLETED" />
            </intent-filter>
        </receiver>

        <service
            android:name=".schedule.ScheduleService"
            android:exported="false"
            android:foregroundServiceType="dataSync" />
    </application>

</manifest>
